NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://gymrat:gymrat@localhost:5432/gymrat?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

MAIL_FROM=noreply@gymrat.local
# When true, password reset tokens are logged (local/dev only)
MAIL_LOG_RESET_TOKENS=true

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# AI parser: rules (default) | openai
AI_PARSER_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VOICE_STORAGE_DIR=./storage/voice
MAX_VOICE_BYTES=26214400
